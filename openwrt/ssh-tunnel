// /etc/init.d/ssh-tunnel

#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command ssh \
        -N \
        -L 127.0.0.1:1080:127.0.0.1:6666 \
        root@SERVER_IP
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
